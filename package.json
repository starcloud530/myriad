{
  "name": "myriad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One API for chat, image, video, and speech.",
  "homepage": "https://starcloud530.github.io/myriad/docs/quickstart",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @myriad/gateway",
    "dev:web": "npm run dev -w @myriad/web",
    "dev:cli": "npm run start -w @myriad/cli --",
    "deploy": "npm run deploy -w @myriad/gateway",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "assets:upload": "node ../../assets/vendors/upload-to-r2.mjs"
  }
}
